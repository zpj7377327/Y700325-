CONFIG_TECHPACK_CAMERA_OPPO=y

# ===== JEAN perf tuning 2026-10-17 =====
# BBR 依赖 fq, Android netd 用 fq_codel; 原配置两者都没编 -> 只能退回 pfifo_fast,
# 高负载下延迟变差(bufferbloat), 且 BBR 无法发挥
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
# 纯调试校验, 关闭可去掉链表操作热路径的运行时检查(整机列表操作无处不在)
# CONFIG_DEBUG_LIST is not set

# USB Virtual Serial / ACM CDC Gadget for early kernel debugging
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_SERIAL=y
